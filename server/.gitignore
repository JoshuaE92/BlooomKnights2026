# Dependencies
node_modules/

# Environment variables (never commit secrets/API keys)
.env
.env.local
.env.development
.env.test
.env.production

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage / testing
coverage/
.nyc_output/

# Build output (if you transpile with Babel/TypeScript)
dist/
build/

# OS-generated files
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo

# Local throwaway smoke test (not part of the app)
_smoke.js

# Optional: dependency lock mismatches
# (keep package-lock.json or yarn.lock committed — don't ignore these)