# Copy this file to .env and fill in real values.
PORT=5050
NODE_ENV=development
# Get this from your DB friend once db.js is wired up.
MONGO_URI=mongodb://127.0.0.1:27017/bloomknights
# Google Gemini API key (from Google AI Studio). Leave blank to use the mock AI.
GEMINI_API_KEY=
# 'mock' = free, no Gemini calls (dev/testing). 'live' = real Gemini. Default: live.
AI_MODE=mock
