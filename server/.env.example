# Copy this file to .env and fill in real values.

PORT=5000
NODE_ENV=development

# --- Database (required — server won't boot without it) ---
MONGO_URI=mongodb://127.0.0.1:27017/greencart

# --- Auth (required) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Email (Resend HTTPS API — https://resend.com, API Keys page) ---
# EMAIL_FROM must be an address on the domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# --- Frontend URL (used in email links + CORS) ---
CLIENT_URL=http://localhost:3000

# --- AI / product layer ---
# Google Gemini API key (from Google AI Studio). Leave blank to use the mock AI.
GEMINI_API_KEY=
# 'live' = real Gemini calls (default; falls back to mock if no key or on error).
# 'mock' = never call Gemini (free, deterministic — good for dev/testing).
AI_MODE=live

# GNews API key (https://gnews.io, free tier) — powers /api/ai/articles
# "learn more" links per green tag. Optional: blank = empty article lists.
GNEWS_API_KEY=
