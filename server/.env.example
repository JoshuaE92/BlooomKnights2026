# Copy this file to .env and fill in real values.

PORT=5000
NODE_ENV=development

# --- Database (required — server won't boot without it) ---
MONGO_URI=mongodb://127.0.0.1:27017/bloomknights

# --- Auth (required) ---
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# --- Email (Gmail SMTP — use an App Password, not your real password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Frontend URL (used in email links) ---
CLIENT_URL=http://localhost:3000

# --- AI / product layer ---
# Google Gemini API key (from Google AI Studio). Leave blank to use the mock AI.
GEMINI_API_KEY=
# 'mock' = free, no Gemini calls (dev/testing). 'live' = real Gemini. Default: live.
AI_MODE=mock
